const SideTab* sideTabFor(int id) {
    for (const SideTab& t : kSideTabs) if (t.id == id) return &t;
    return nullptr;
}
// Tablo enterpolasyonu: s artmayan ilk eleman tablonun sonu
double tabLerp(const double (*t)[2], int cap, double s) {
    int n = 1;
    while (n < cap && t[n][0] > t[n - 1][0]) ++n;
    if (s <= t[0][0]) return t[0][1];
    for (int i = 1; i < n; ++i)
        if (s <= t[i][0]) { const double k = (s - t[i - 1][0]) / (t[i][0] - t[i - 1][0]); return t[i - 1][1] + (t[i][1] - t[i - 1][1]) * k; }
    return t[n - 1][1];
}
